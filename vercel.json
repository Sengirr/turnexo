{
  "functions": {
    "api/cron-outreach.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-outreach",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
